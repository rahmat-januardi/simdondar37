// === FUNGSI AMBIL PRODUCTION TYPE ===
function getProductionTypes($dbi, $tgl1, $tgl2)
{
    $sql = "SELECT DISTINCT s.ktg_produk 
            FROM pmf_stokkantong s
            LEFT JOIN pmf_distribusi d ON s.puf_trxdistribusi = d.pmfd_notransaksi
            WHERE DATE(d.pmfd_tanggal) BETWEEN '$tgl1' AND '$tgl2' 
            AND s.puf_trxdistribusi IS NOT NULL 
            AND s.puf_status = '1'
            AND s.ktg_produk IS NOT NULL
            AND s.ktg_produk != ''
            ORDER BY s.ktg_produk ASC";

    $query = mysqli_query($dbi, $sql);
    $produk = array();

    while ($row = mysqli_fetch_assoc($query)) {
        if (!empty($row['ktg_produk'])) {
            $produk[] = $row['ktg_produk'];
        }
    }

    return !empty($produk) ? implode(', ', $produk) : 'Unknown';
}

// === PROSES SIMPAN BOL (GENERATE OTOMATIS) ===
if (isset($_POST["btnSimpanBOL"])) {
    $tgl1   = mysqli_real_escape_string($dbi, $_POST["tgl_kirim1"]);
    $tgl2   = mysqli_real_escape_string($dbi, $_POST["tgl_kirim2"]);
    $tahap  = mysqli_real_escape_string($dbi, $_POST["tahap_pengiriman"]);
    $prefix = mysqli_real_escape_string($dbi, $_POST["perusahaan"]); // Ambil prefix dari pilihan perusahaan

    // Validasi tanggal
    if ($tgl2 < $tgl1) {
        $temp = $tgl1;
        $tgl1 = $tgl2;
        $tgl2 = $temp;
    }

    // Validasi tahap
    $tahap = str_pad($tahap, 2, '0', STR_PAD_LEFT); // jadi 01, 02, ..., 12

    // Generate BOL: [PREFIX][YY][MM][KODE UDD][TAHAP]
    $yy = substr($tgl1, 2, 2); // 25
    $mm = substr($tgl1, 5, 2); // 11
    $no_bol = "{$prefix}{$yy}{$mm}{$udd_kode}{$tahap}";

    // Cek apakah ada data di rentang tanggal
    $check = mysqli_query($dbi, "SELECT COUNT(*) as total FROM pmf_distribusi 
                                 WHERE DATE(pmfd_tanggal) BETWEEN '$tgl1' AND '$tgl2'");
    $row = mysqli_fetch_assoc($check);

    if ($row['total'] == 0) {
        echo "<script>
            Swal.fire('Peringatan', 'Tidak ada data distribusi pada rentang tanggal yang dipilih.', 'warning');
        </script>";
    } else {
        // Update BOL
        $update_sql = "UPDATE pmf_distribusi 
                       SET pmfd_no_bol = '$no_bol'
                       WHERE DATE(pmfd_tanggal) BETWEEN '$tgl1' AND '$tgl2'";

        if (mysqli_query($dbi, $update_sql)) {
            $affected = mysqli_affected_rows($dbi);
            echo "<script>
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: 'Nomor BOL <strong>$no_bol</strong> disimpan ke $affected record.',
                    html: true,
                    timer: 3000,
                    showConfirmButton: false
                }).then(() => { window.location.href = window.location.href; });
            </script>";
        } else {
            echo "<script>
                Swal.fire('Error', 'Gagal menyimpan: " . mysqli_error($dbi) . "', 'error');
            </script>";
        }
    }
}

