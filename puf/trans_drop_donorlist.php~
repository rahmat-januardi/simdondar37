                updatePreviewBOL();
            });

            $('input[name="tgl_kirim1"], #perusahaan, #tahap_pengiriman').on('change', function() {
                updatePreviewBOL();
            });

            function updatePreviewBOL() {
                const tgl = $('input[name="tgl_kirim1"]').val();
                const prefix = $('#perusahaan').val();
                const tahap = $('#tahap_pengiriman').val();
                if (tgl && prefix && tahap) {
                    const yy = tgl.substr(2, 2);
                    const mm = tgl.substr(5, 2);
                    const kode = '<?= $udd_kode ?>';
                    const th = tahap.padStart(2, '0');
                    $('#preview_bol').val(`${prefix}${yy}${mm}${kode}${th}`);
                } else {
                    $('#preview_bol').val('');
                }
            }

            $('#tabledata').DataTable({
                paging: true,
                searching: true,
                info: true, // opsional, biar ada tulisan "Showing 1 to 10 of 384 entries"
                lengthChange: true, // <-- DIIJINKAN lagi
                pageLength: 10, // default tampilkan 25 baris (bisa diganti 10/50 sesuai selera)
                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "All"]
                ], // <-- INI YANG ANDA MAU!
                order: [
                    [1, 'asc']
                ],
                language: {
                    lengthMenu: "Tampilkan _MENU_ data per halaman",
                    info: "Menampilkan _START_ sampai _END_ dari _TOTAL_ data",
                    paginate: {
                        previous: "Sebelumnya",
                        next: "Berikutnya"
                    }
                }
            });
        });

        function exportToExcel() {
            const dtTable = $('#tabledata').DataTable(); // Ambil instance DataTables

            // Ambil header row menggunakan API DataTables
            const headerRow = dtTable.columns().header().toArray().map(header => header.innerText.trim());

            // Ambil SEMUA body data (mengabaikan paging, search, dll.)
            // Ini akan mengembalikan array of arrays, setiap array adalah satu baris data (text clean tanpa HTML)
            const bodyData = dtTable.rows({
                search: 'applied',
                order: 'applied'
            }).data().toArray();

            // Ambil totals dari window.exportTotals (sudah dari PHP)
            const totalKantong = window.exportTotals.units || 0;
            const totalVolume = window.exportTotals.volume || 0;
            const productionType = window.exportTotals.productionTypes || 'Unknown';

            const units = totalKantong.toLocaleString('en-US');
            const totalMilliliters = totalVolume.toLocaleString('en-US');

            const bloodCenter = '<?= addslashes($udd_nama) ?>';
            const address = '<?= addslashes($udd_alamat) ?>';

            const dateInput = document.querySelector('input[name="tanggal_kirim1"]').value;
            const date1 = new Date(dateInput);
            const day = date1.getDate().toString().padStart(2, '0');
            const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
                'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
            ];
            const month = monthNames[date1.getMonth()];
            const year = date1.getFullYear();
            const shippingDate = `${day} ${month} ${year}`;

            // Header data tambahan (sama seperti sebelumnya)
            const headerData = [
                ['Blood Center:', bloodCenter],
                ['Address:', address],
                ['Shipping Date:', shippingDate],
                ['Production Type:', productionType],
                ['Units:', units],
                ['Total Milliliters:', totalMilliliters],
                []
            ];

            // Gabungkan semuanya: headerData + headerRow + bodyData
            const wsData = [...headerData, headerRow, ...bodyData];

            // Buat worksheet
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet(wsData);

            // Set lebar kolom (sama seperti sebelumnya)
            ws['!cols'] = [{
                    wch: 20
                }, {
                    wch: 19
                }, {
                    wch: 18
                }, {
                    wch: 16
                }, {
                    wch: 10
                },
                {
                    wch: 8
                }, {
                    wch: 8
                }, {
                    wch: 8
                }, {
                    wch: 10
                }, {
                    wch: 10
                }, {
                    wch: 10
                }, {
                    wch: 10
                }
            ];

            // Styling (bold untuk header dan totals) - sama seperti sebelumnya
            const range = XLSX.utils.decode_range(ws['!ref']);
            for (let R = 0; R <= range.e.r; ++R) {
                for (let C = 0; C <= range.e.c; ++C) {
                    const cell_address = {
                        c: C,
                        r: R
                    };
                    const cell_ref = XLSX.utils.encode_cell(cell_address);
                    if (!ws[cell_ref]) continue;

                    if (R === 7 || R === wsData.length - 1) { // Row header tabel dan total (adjust jika perlu)
                        ws[cell_ref].s = {
                            font: {
                                bold: true
                            }
                        };
                    }
                    if (C === 0 && R < 7) {
                        ws[cell_ref].s = {
                            font: {
                                bold: true
                            }
                        };
                    }
                }
            }

            // Append sheet dan download
            XLSX.utils.book_append_sheet(wb, ws, 'Donorlist');

            const date1Raw = document.querySelector('input[name="tanggal_kirim1"]').value;
            const date2Raw = document.querySelector('input[name="tanggal_kirim2"]').value;
            XLSX.writeFile(wb, `Donorlist_Pengiriman_${date1Raw}_sd_${date2Raw}.xlsx`);
        }

        const load = document.getElementById("loading");
        window.addEventListener('load', () => load.style.display = "none");
    </script>
