    <script>
        function toggleOtherInput() {
            const checkbox = document.getElementById('otherDestination');
            const input = document.getElementById('otherDestinationInput');
            const display = document.getElementById('otherTextDisplay');

            if (checkbox.checked) {
                input.style.display = 'inline-block';
                input.focus();
                // Kosongkan placeholder garis bawah jika diisi
                if (input.value.trim() !== '') {
                    display.innerHTML = '<strong>' + input.value + '</strong>';
                }
            } else {
                input.style.display = 'none';
                display.innerHTML = '___________________________________';
            }
        }

        // Jalankan saat halaman dimuat (jika sebelumnya sudah dicentang)
        document.addEventListener('DOMContentLoaded', function() {
            toggleOtherInput();
        });

        // Update teks saat user mengetik
        document.getElementById('otherDestinationInput').addEventListener('input', function() {
            if (document.getElementById('otherDestination').checked) {
                const val = this.value.trim();
                document.getElementById('otherTextDisplay').innerHTML = val ? '<strong>' + val.escapeHtml() + '</strong>' : '___________________________________';
            }
        });

        // Fungsi escape HTML sederhana
        String.prototype.escapeHtml = function() {
            const div = document.createElement('div');
            div.textContent = this;
            return div.innerHTML;
        };
    </script>
