// === PROSES GENERATE COQ ===
if (isset($_POST["btnGenerateCOQ"])) {
    $f_shipment_date = $_POST["shipment_date"];
    $no_bol = mysqli_real_escape_string($dbi, $_POST["no_bol"]);

    // Ambil data berdasarkan BOL
    $sql = "SELECT 
                d.pmfd_no_bol,
                d.pmfd_kodebox,
                d.pmfd_tanggal,
                MIN(s.ktg_tgl_aftap) as tgl_awal,
                MAX(s.ktg_tgl_aftap) as tgl_akhir,
                COUNT(DISTINCT d.pmfd_kodebox) as jumlah_kardus,
                COUNT(s.ktg_kantong) as jumlah_kantong,
                SUM(s.ktg_volume) as total_volume
            FROM pmf_stokkantong s
            LEFT JOIN pmf_distribusi d ON s.puf_trxdistribusi = d.pmfd_notransaksi
            WHERE d.pmfd_no_bol = '$no_bol'
            AND s.puf_trxdistribusi IS NOT NULL 
            AND s.puf_status = '1'
            GROUP BY d.pmfd_no_bol";

    $query = mysqli_query($dbi, $sql);
    $data_coq = mysqli_fetch_assoc($query);

    if (!$data_coq) {
        echo "<script>
            Swal.fire('Peringatan', 'Nomor BOL tidak ditemukan!', 'warning');
        </script>";
    }

    // === AMBIL DATA KANTONG DARI pmf_stokkantong + JOIN ke master_kantong ===
    $kantong_query = mysqli_query($dbi, "
    SELECT DISTINCT 
        s.ktg_merk,
        s.ktg_jenis,
        s.ktg_volumeasal,
        COALESCE(m.company, 'Unknown Manufacturer') AS company
    FROM pmf_stokkantong s
    LEFT JOIN pmf_distribusi d ON s.puf_trxdistribusi = d.pmfd_notransaksi
    LEFT JOIN master_kantong m 
        ON TRIM(UPPER(s.ktg_merk)) = TRIM(UPPER(m.merk))
        AND s.ktg_jenis = m.jenis
        AND s.ktg_volumeasal = m.vol
    WHERE d.pmfd_no_bol = '$no_bol'
      AND s.puf_trxdistribusi IS NOT NULL 
      AND s.puf_status = '1'
      AND s.ktg_merk IS NOT NULL
      AND s.ktg_merk != ''
    ORDER BY s.ktg_merk, s.ktg_jenis, s.ktg_volumeasal
");

    $daftar_kantong = array();

    while ($row = mysqli_fetch_assoc($kantong_query)) {
        $kode_merk = trim($row['ktg_merk']);
        $jenis     = ($row['ktg_jenis'] == 2) ? 'Double' : 'Triple';
        $volume    = (int)$row['ktg_volumeasal'];
        $company   = trim($row['company']);

        // Jika company tidak ketemu di master, pakai kode merk saja sebagai fallback
        if ($company === '' || $company === 'Unknown Manufacturer') {
            $company = $kode_merk;
        }

        $daftar_kantong[] = "$kode_merk $jenis {$volume} mL / $company";
    }

    // Hapus duplikat dan urutkan
    $daftar_kantong = array_unique($daftar_kantong);
    sort($daftar_kantong);
}
